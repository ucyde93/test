{
  "name": "sahifa-pdf",
  "version": "1.2.1",
  "description": "Sahifa PDF",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/version.test.js && node test/secure-library.test.js && node test/e2e.js",
    "test:unit": "node test/version.test.js && node test/secure-library.test.js",
    "test:e2e": "node test/e2e.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "screenshots": "node scripts/screenshots.js"
  },
  "author": {
    "name": "MV Digital Tools"
  },
  "license": "MIT",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^3.11.174"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.56.1"
  },
  "productName": "Sahifa PDF",
  "private": true,
  "homepage": "https://github.com/ucyde93/test/tree/main/sahifa-pdf",
  "build": {
    "appId": "com.mvdigitaltools.sahifapdf",
    "productName": "Sahifa PDF",
    "copyright": "© 2026 MV Digital Tools",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json",
      "build/icon.png",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.d.ts",
      "!**/node_modules/**/{README,CHANGELOG,readme,changelog}*",
      "!**/node_modules/pdfjs-dist/{legacy,types,web,lib}/**",
      "!**/node_modules/pdfjs-dist/build/{pdf.js,pdf.worker.js,pdf.sandbox*,pdf.worker.entry.js}",
      "!**/node_modules/@cantoo/pdf-lib/{cjs,es,src,ts3.4}/**",
      "!**/node_modules/@cantoo/pdf-lib/dist/*.esm*",
      "!**/node_modules/pdf-lib/{es,dist,src,ts3.4}/**",
      "!**/node_modules/@fontsource/*/files/*-{cyrillic,cyrillic-ext,greek,greek-ext,vietnamese}-*",
      "!**/node_modules/@fontsource/*/files/*.woff"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "legalTrademarks": "Sahifa PDF is a product of MV Digital Tools",
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "MVDigitalTools.SahifaPDF.Document",
          "description": "PDF Document",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "MV Digital Tools",
      "shortcutName": "Sahifa PDF",
      "uninstallDisplayName": "Sahifa PDF",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/installer.ico",
      "uninstallerIcon": "build/installer.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "artifactName": "Sahifa-PDF-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Sahifa-PDF-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "Sahifa-PDF-${version}-${arch}.${ext}",
      "minimumSystemVersion": "11.0",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "PDF Document",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "com.adobe.pdf"
            ],
            "CFBundleTypeExtensions": [
              "pdf"
            ],
            "CFBundleTypeIconFile": "icon.icns"
          }
        ],
        "NSHumanReadableCopyright": "© 2026 MV Digital Tools"
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "Sahifa-PDF-${version}.${ext}",
      "mimeTypes": [
        "application/pdf"
      ],
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF Document",
          "description": "PDF Document",
          "mimeType": "application/pdf",
          "role": "Editor"
        }
      ]
    },
    "publish": null,
    "extraMetadata": {
      "productName": "Sahifa PDF"
    },
    "afterPack": "build/afterPack.js",
    "dmg": {
      "title": "Sahifa PDF ${version}",
      "contents": [
        {
          "x": 150,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 550,
        "height": 380
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ucyde93/test.git",
    "directory": "sahifa-pdf"
  }
}
